#!/bin/sh
# 首次开机兜底：把 mwan3 的预置配置清空
#
# 为什么需要这一步：上游 mwan3 包自带 4 个接口(wan/wan6/wanb/wanb6)、
# 10 个成员、5 个策略、3 条规则。其中 wan 为 enabled=1 并绑定 1.0.0.1 等
# 跟踪 IP，单网口或首启无外网时会显示"离线"，其余接口显示"已禁用"，
# 容易被误认为固件配置错误。
#
# 本固件要求出厂状态为「零接口、零策略」，由用户按需自行创建。
# 若 files/etc/config/mwan3 的覆盖未生效（包内文件后装），这里会兜底处理。

CFG="/etc/config/mwan3"

if [ -f "$CFG" ] && uci -q show mwan3 2>/dev/null | grep -qE '=(interface|member|policy|rule)$'; then
    cat > "$CFG" <<'EOF'
# MultiWAN Manager 默认配置为空，请勿删除本文件。
# 需要多拨或多线路时，请在 LuCI「网络 → MultiWAN 管理器」中新建接口。
EOF
    rm -rf /var/etc/mwan3 /var/run/mwan3 /var/run/mwan3track 2>/dev/null
    logger -t mwan3-blank "已清空 mwan3 预置配置（wan/wan6/wanb/wanb6 及成员策略规则）"
    echo "mwan3 preset config cleared at $(date)" >> /etc/config/uci-defaults-log.txt
fi

exit 0
