#!/bin/sh
# SmartDNS 出厂默认值
#
# 1) 关闭「自动设置 Dnsmasq」
#    根因：luci-app-smartdns 的 smartdns.js 里写的是
#      o = s.taboption("settings", form.Flag, "auto_set_dnsmasq", ...)
#      o.default = o.enabled
#    form.Flag 的 enabled 默认为 true，所以配置里没有该键时页面渲染为「已勾选」，
#    保存后会把 dnsmasq 上游改成 127.0.0.1#<smartdns端口>，接管整机 DNS。
#    显式写入 '0' 后即渲染为未勾选。
#
# 2) 本地端口预设 6053（而非 53）
#    smartdns init 里 config_get port "$section" "port" "53"，默认 53；
#    写成 6053 避免与 dnsmasq 抢 53 端口。
#
# 3) 高级设置里不勾选「TCP 服务器」「IPV6 服务器」
#    init 中 config_get tcp_server ... "1" / config_get ipv6_server ... "1"，
#    默认均为开启，写 '0' 即关闭对应 bind / bind-tcp 条目。

CFGLOG=/etc/config/uci-defaults-log.txt

if uci -q get smartdns.@smartdns[0] >/dev/null 2>&1; then
    uci -q set smartdns.@smartdns[0].auto_set_dnsmasq='0'
    uci -q set smartdns.@smartdns[0].port='6053'
    uci -q set smartdns.@smartdns[0].tcp_server='0'
    uci -q set smartdns.@smartdns[0].ipv6_server='0'
    uci -q commit smartdns

    /etc/init.d/smartdns restart >/dev/null 2>&1

    echo "smartdns: auto_set_dnsmasq=0 port=6053 tcp_server=0 ipv6_server=0 at $(date)" >> "$CFGLOG"
fi

exit 0
