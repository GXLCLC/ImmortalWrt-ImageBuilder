#!/bin/sh
# 关闭 smartdns 的「自动设置 Dnsmasq」默认勾选
#
# 背景：luci-app-smartdns 的前端 smartdns.js 里写的是
#   o=s.taboption("settings", form.Flag, "auto_set_dnsmasq", ...)
#   o.default = o.enabled
# 而 form.Flag 的 enabled 默认为 true，所以只要配置里没有显式写这一项，
# 页面就会渲染成「已勾选」，保存后就会把 dnsmasq 的上游改成
# 127.0.0.1#<smartdns端口>，接管整机 DNS。
#
# 本固件要求出厂状态为「不勾选」，即不自动改动 dnsmasq。
# 显式写入 '0' 后，前端读到该值即渲染为未勾选。

if uci -q get smartdns.@smartdns[0] >/dev/null 2>&1; then
    uci -q set smartdns.@smartdns[0].auto_set_dnsmasq='0'
    uci -q commit smartdns
    logger -t smartdns-default "已关闭 smartdns 自动设置 Dnsmasq（auto_set_dnsmasq=0）"
    echo "smartdns auto_set_dnsmasq=0 applied at $(date)" >> /etc/config/uci-defaults-log.txt
fi

exit 0
